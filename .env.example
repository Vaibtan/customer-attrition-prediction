# Runtime knobs (churn.settings.Settings). Copy to .env / export as needed; every value shown is
# the default. Frozen ML policy (thresholds, MDEs) lives in src/churn/config.py, NOT here.

# --- stores & transport -------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDPANDA_BROKER=localhost:9092
EVENTS_TOPIC=customer-events
CONSUMER_GROUP=churn-streaming-v1
EVENTS_PARQUET=data/stream/events.parquet

# --- scoring instant (frozen world: freshness = equality with this, not a TTL) -------------------
CHURN_AS_OF=2025-01-01T00:00:00

# --- consumer -----------------------------------------------------------------------------------
CHURN_STATE_DIR=/tmp/quix-state
CONSUMER_TIMEOUT=0

# --- models -------------------------------------------------------------------------------------
# Batch scoring run dir (default: latest under models/)
CHURN_MODEL_RUN_DIR=
# Online (static+event) model run dir
CHURN_ONLINE_MODEL_RUN_DIR=
# MLflow tracking server (unset = MLflow-dependent features degrade gracefully)
MLFLOW_TRACKING_URI=
