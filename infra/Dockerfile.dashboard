# Streamlit ML mission-control (Phase 6). Base deps (pandas/sklearn/matplotlib) + the dashboard
# extra (streamlit); the data logic lives in services.dashboard.mission_control.
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --extra dashboard

COPY services ./services

# Non-root runtime (REV-16). --create-home gives Streamlit a writable ~/.streamlit.
RUN useradd --system --uid 10001 --create-home appuser
USER appuser

ENV PATH="/opt/venv/bin:${PATH}"
EXPOSE 8501

CMD ["streamlit", "run", "services/dashboard/app.py", \
     "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
